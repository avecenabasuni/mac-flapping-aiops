          },
          {
            "q": "sum:snmp.ifHCOutOctets.rate{env:network-aiops,lab_id:macflap-v2,lab_device:sw1} by {interface}",
            "display_type": "line"
          }
        ]
      },
      "layout": {
        "width": 6,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "SW1 interface error rates",
        "requests": [
          {
            "q": "sum:snmp.ifInErrors.rate{env:network-aiops,lab_id:macflap-v2,lab_device:sw1} by {interface}",
            "display_type": "line"
          },
          {
            "q": "sum:snmp.ifOutErrors.rate{env:network-aiops,lab_id:macflap-v2,lab_device:sw1} by {interface}",
